rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products are publicly readable
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Should be managed by admins
    }

    // User data can only be read/written by authenticated users for their own document,
    // or by admins.
    match /users/{userId} {
      allow read, update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create: if request.auth != null;
    }
  }
}
